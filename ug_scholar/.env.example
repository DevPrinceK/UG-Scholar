DJANGO_SECRET_KEY=replace-with-a-long-random-value
# During planned rotation, keep prior keys comma-separated until old sessions expire.
DJANGO_SECRET_KEY_FALLBACKS=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=scholar.example.edu
CORS_ALLOW_ALL_ORIGINS=false
DJANGO_SESSION_COOKIE_AGE=1209600
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Recommended production database. Leave blank for local SQLite development.
# DATABASE_URL=postgresql://user:password@localhost:5432/ug_scholar
DATABASE_URL=

# OpenAlex is the default provider. A free key includes a daily allowance.
SCHOLAR_DATA_PROVIDER=openalex
OPENALEX_API_KEY=
SCHOLAR_HTTP_TIMEOUT=30
SCHOLAR_QUEUE_AUTOSTART=false
SCHOLAR_QUEUE_POLL_SECONDS=2
SCHOLAR_USER_AGENT=UG-Scholar/1.0 (mailto:library@example.edu)

# Optional paid fallback only. Never commit the real key.
SERPAPI_API_KEY=
